{
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "backend": "docker compose up --build",
    "start": "concurrently -k -n frontend,backend \"npm run dev\" \"docker compose up --build\"",
    "stop": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
